[Unit]
Description=RaspberryRelay controller daemon
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/bin/relayd -config /etc/relayd/config.json
Restart=on-failure
RestartSec=2

User=relayd
Group=relayd
# Bind :80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. relayd only needs to write its own config directory; the rest
# of the filesystem stays read-only to it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/relayd
# /dev/gpiochip0 access is granted via group membership (see install.sh),
# not DeviceAllow, because ProtectSystem=strict does not restrict /dev.

[Install]
WantedBy=multi-user.target
